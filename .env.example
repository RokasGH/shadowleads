# Copy to .env and fill in. Every variable is optional:
# without GOOGLE_MAPS_API_KEY the container serves the committed offline demo.

# Google Maps Platform - Places API (New). Restrict the key to "Places API (New)".
GOOGLE_MAPS_API_KEY=

# Oxylabs Web Scraper API (free trial) - used only for company-code lookups
# (linking fallback + link validation).
OXYLABS_USERNAME=
OXYLABS_PASSWORD=
OXYLABS_API_URL=https://realtime.oxylabs.io/v1/queries
OXYLABS_GEO_LOCATION=Vilnius,Lithuania

# Optional overrides
# SHADOWLEADS_DATA_DIR=data
# SHADOWLEADS_GOOGLE_BUDGET=900
# SHADOWLEADS_OXYLABS_BUDGET=300
# SHADOWLEADS_PSEUDONYM_KEY=change-me
